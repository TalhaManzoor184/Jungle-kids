# Copy to .env for local runs. On GitHub these are repository secrets / variables.
GEMINI_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# veo (automatic, paid Gemini API) · inbox (free, clips from Google Flow) · still (tests)
CLIP_SOURCE=veo
UPLOAD_MODE=schedule
PUBLISH_TIME=18:00
PUBLISH_UTC_OFFSET=5
MADE_FOR_KIDS=false
SHOT_SECONDS=6
